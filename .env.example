# Local runtime
GOVERNOR_DB_PATH=data/governor.db
GOVERNOR_EXECUTION_MODE=dry-run
GOVERNOR_ALLOW_CRITICAL_ACTIONS=false
GOVERNOR_ALLOW_LIVE_INPUT=false
GOVERNOR_ALLOW_LIVE_INPUT=false
GOVERNOR_GAME_WINDOW_TITLE=满庭芳：宋上繁华
GOVERNOR_MEMORY_PROFILE=

# Qwen is the only supported AI provider.
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_VISION_MODEL=
QWEN_REASONING_MODEL=

# Optional read-only Unity/Mono telemetry bridge. Missing bridge data is UNKNOWN;
# the Governor never invents zero values and never writes to the game process.
GOVERNOR_RUNTIME_BRIDGE_URL=http://127.0.0.1:18765
GOVERNOR_RUNTIME_TELEMETRY=false
GOVERNOR_RUNTIME_GAME_VERSION=
GOVERNOR_AUTO_FOREGROUND=false
GOVERNOR_RESTORE_PREVIOUS_FOREGROUND=true
GOVERNOR_FOREGROUND_STABLE_SECONDS=0.6
GOVERNOR_FOREGROUND_TIMEOUT_SECONDS=5.0

# Feishu custom app/bot integration is optional in the local scaffold.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_API_BASE=https://open.feishu.cn
FEISHU_TARGET_CHAT_ID=
